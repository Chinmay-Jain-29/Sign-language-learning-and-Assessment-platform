# Backend Environment Configuration Template
ENVIRONMENT=development
PROJECT_NAME="AI Sign Language Learning & Assessment Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# Database URL
DATABASE_URL=sqlite:///./sign_language.db

# Secrets & Security
SECRET_KEY=your-secure-random-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Model Configuration
MODEL_PATH=app/ai/ml/models/gesture_model.joblib
MODEL_VERSION=v1.0.0
MODEL_CONFIDENCE_THRESHOLD=0.75
AI_MODE=production

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
