# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Application Environment (development | testing | production)
ENVIRONMENT=development
PROJECT_NAME="AI-Powered Sign Language Learning & Assessment Platform"
VERSION=1.0.0

# Database Configuration (PostgreSQL URL or SQLite fallback)
# Production Example: postgresql://username:password@localhost:5432/sign_language_db?sslmode=require
# Development Fallback: sqlite:///./sign_language.db
DATABASE_URL=sqlite:///./sign_language.db

# Authentication & JWT Secrets (Change in Production)
SECRET_KEY=your-secure-random-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Model Configuration
MODEL_PATH=app/ai/ml/models/gesture_model.joblib
MODEL_VERSION=v1.0.0
MODEL_CONFIDENCE_THRESHOLD=0.75
AI_MODE=production

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
